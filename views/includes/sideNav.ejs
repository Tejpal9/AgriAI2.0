<!-- Mobile overlay backdrop -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Mobile open button -->
<button class="sidebar-mobile-toggle d-md-none" id="sidebarOpenBtn" aria-label="Open menu">
  <i class="bx bx-menu"></i>
</button>

<nav class="sidebar" id="sidebar">
  <header>
    <div class="image-text">
      <span class="Logoimage">
        <img src="images/mainLogo.jpeg" alt="AgriAI Logo">
      </span>
      <div class="text header-text">
        <span class="name" style="font-size: 22px; color: teal; margin-left: 1rem;">AgriAI</span>
      </div>
    </div>
    <i class="bx bxs-chevron-right toggle" id="sidebarToggle"></i>
  </header>

  <div class="menu-bar">
    <div class="menu">
      <ul class="menu-links">
        <li class="search-box">
          <i class="bx bx-search icon"></i>
          <input type="text" placeholder="Search.." />
        </li>
        <li class="nav-link">
          <a href="/">
            <i class="bx bx-home icon"></i>
            <span class="text nav-text">Home</span>
          </a>
        </li>
        <li class="nav-link">
          <a href="<%= detectionAppUrl %>">
            <i class="bx bxs-leaf icon"></i>
            <span class="text nav-text">Disease Detection</span>
          </a>
        </li>
        <li class="nav-link">
          <a href="/community">
            <i class="bx bx-donate-heart icon"></i>
            <span class="text nav-text">Community</span>
          </a>
        </li>
        <li class="nav-link">
          <a href="/fertilizer">
            <i class="fa-solid fa-bug-slash icon"></i>
            <span class="text nav-text">Fertilizer</span>
          </a>
        </li>
        <li class="nav-link">
          <a href="/alert">
            <i class="fa-solid fa-circle-exclamation icon"></i>
            <span class="text nav-text">Weather Alerts</span>
          </a>
        </li>
        <li class="nav-link">
          <a href="/gemini">
            <i class="fa-solid fa-robot icon"></i>
            <span class="text nav-text">Chatbot</span>
          </a>
        </li>
        <li class="nav-link">
          <a href="/settings">
            <i class="fa-solid fa-gear icon"></i>
            <span class="text nav-text">Settings</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="bottom-content">
      <li class="">
        <% if(!currentUser){ %>
          <a href="/login">
            <i class="bx bx-log-in icon"></i>
            <span class="text nav-text">Login</span>
          </a>
        <% } else { %>
          <a href="/logout" onclick="return confirmLogout(event)">
            <i class="bx bx-log-out icon"></i>
            <span class="text nav-text">Logout</span>
          </a>
        <% } %>
      </li>

      <li class="mode">
        <div class="moon-sun">
          <i class="bx bx-moon icon moon"></i>
          <i class="bx bx-sun icon sun"></i>
        </div>
        <span class="mode-text text">Dark Mode</span>
        <div class="toggle-switch">
          <span class="switch"></span>
        </div>
      </li>
    </div>
  </div>
</nav>

<script>
  function confirmLogout(event) {
    event.preventDefault();
    const userConfirmed = confirm("Do you really want to log out?");
    if (userConfirmed) {
      window.location.href = "/logout";
    }
  }

  // Mobile sidebar open/close via overlay
  const sidebarOpenBtn = document.getElementById("sidebarOpenBtn");
  const sidebarOverlay = document.getElementById("sidebarOverlay");
  const sidebar = document.getElementById("sidebar");

  function openSidebar() {
    sidebar.classList.add("mobile-open");
    sidebarOverlay.classList.add("active");
    document.body.style.overflow = "hidden";
  }

  function closeSidebar() {
    sidebar.classList.remove("mobile-open");
    sidebarOverlay.classList.remove("active");
    document.body.style.overflow = "";
  }

  if (sidebarOpenBtn) sidebarOpenBtn.addEventListener("click", openSidebar);
  if (sidebarOverlay) sidebarOverlay.addEventListener("click", closeSidebar);
</script>
<script src="/JS/script.js"></script>